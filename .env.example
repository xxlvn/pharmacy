# Строка подключения к PostgreSQL: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/pharmacy?schema=public"

# Секрет для подписи JWT — длинная случайная строка (минимум 32 символа).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace_with_long_random_string_at_least_32_chars"
JWT_EXPIRES_IN="1d"

PORT=3000
NODE_ENV=development

# Администратор, которого создаёт seed (prisma/seed.js). Других входов seed не создаёт.
# Пароль: минимум 8 символов, буква и цифра.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change_me_123"
ADMIN_NAME="Администратор"
