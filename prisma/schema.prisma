// Схема базы данных интернет-аптеки.
// 5 сущностей: User, Category, Product, Order, OrderItem.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING    // создан, ожидает подтверждения
  CONFIRMED  // подтверждён аптекой
  SHIPPED    // передан в доставку
  DELIVERED  // доставлен
  CANCELLED  // отменён
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  avatarUrl    String?  @map("avatar_url") // /api/uploads/<id>, загружается самим пользователем
  // Момент последней смены пароля: токены, выданные раньше, перестают действовать
  passwordChangedAt DateTime? @map("password_changed_at")

  // Восстановление пароля: хранится только SHA-256 хеш одноразового токена из письма

  // Двухфакторная аутентификация (TOTP, приложение-аутентификатор).
  // Секреты хранятся зашифрованными (AES-256-GCM), резервные коды — только хешами.
  totpEnabled       Boolean   @default(false) @map("totp_enabled")
  totpSecret        String?   @map("totp_secret")
  totpPendingSecret String?   @map("totp_pending_secret")
  totpLastStep      Int?      @map("totp_last_step") // защита от повторного использования кода
  recoveryCodes     String[]  @default([]) @map("recovery_codes")
  createdAt    DateTime @default(now()) @map("created_at")

  orders Order[]

  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

// Основная сущность — лекарственный товар (полный CRUD).
model Product {
  id                   Int      @id @default(autoincrement())
  name                 String
  description          String?
  manufacturer         String
  form                 String   // таблетки, капсулы, сироп, мазь, спрей…
  dosage               String?  // например, «500 мг»
  price                Int      // цена в тенге
  stock                Int      @default(0) // наличие на складе
  requiresPrescription Boolean  @default(false) @map("requires_prescription")
  imageUrl             String?  @map("image_url")    // фото препарата (URL)
  imageCredit          String?  @map("image_credit") // автор и лицензия фото
  categoryId           Int      @map("category_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([categoryId])
  @@map("products")
}

model Order {
  id        Int         @id @default(autoincrement())
  // null — заказ оформлен без регистрации (гость)
  userId    Int?        @map("user_id")
  // почта покупателя: на неё уходит чек об оплате
  email     String
  status    OrderStatus @default(PENDING)
  total     Int         // сумма заказа в тенге
  address   String
  phone     String
  comment   String?
  // Оплата картой онлайн. Полный номер, срок и CVC на сервер не попадают:
  // хранятся только платёжная система и последние 4 цифры. paidAt = null — оплата при получении.
  paidAt     DateTime? @map("paid_at")
  cardBrand  String?   @map("card_brand")
  cardLast4  String?   @map("card_last4")
  paymentRef String?   @unique @map("payment_ref")
  // SHA-256 ключа доступа к заказу: им гость оплачивает заказ и скачивает квитанцию
  accessHash String?   @unique @map("access_hash")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user  User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId])
  @@map("orders")
}

// Фото, загруженные администратором с компьютера.
// Хранятся в базе, потому что диск бесплатного хостинга очищается при каждом деплое.
model Upload {
  id        Int      @id @default(autoincrement())
  mimeType  String   @map("mime_type") // image/jpeg, image/png, image/webp
  size      Int      // байт
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("uploads")
}

model OrderItem {
  id        Int @id @default(autoincrement())
  orderId   Int @map("order_id")
  productId Int @map("product_id")
  quantity  Int
  price     Int // цена за единицу на момент заказа

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@map("order_items")
}
